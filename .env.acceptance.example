# ─── Acceptance test environment variables ────────────────────────────────────
#
# Copy to .env.acceptance and fill in your values.
# .env.acceptance is listed in .gitignore — NEVER commit credential values.
# In Blocks agent sessions, store secrets via Blocks Secrets (not this file).

# ── Browserless connection ────────────────────────────────────────────────────
# Full WebSocket endpoint for your Browserless instance.
# Examples:
#   wss://production-sfo.browserless.io/playwright?token=YOUR_TOKEN
#   wss://chrome.browserless.io/playwright?token=YOUR_TOKEN
# Omit to run tests against a locally launched Chromium (development mode).
BROWSERLESS_WS_ENDPOINT=

# ── Target URL ────────────────────────────────────────────────────────────────
# The site to run acceptance tests against.
# Defaults to production. Override with a Vercel preview URL for PR checks.
TEST_BASE_URL=https://aurora-webdraft.vercel.app

# ── Vercel deployment protection bypass ──────────────────────────────────────
# Required when testing password-protected Vercel preview deployments.
# Sent as the x-vercel-protection-bypass header on every request.
# Generate: vercel env add VERCEL_AUTOMATION_BYPASS_SECRET
VERCEL_AUTOMATION_BYPASS_SECRET=

# ── Aurora product credentials ────────────────────────────────────────────────
# Only required for authenticated-route tests (authedPage fixture).
# In CI: inject from Blocks Secrets or your secrets manager, never from a file.
AURORA_TEST_EMAIL=
AURORA_TEST_PASSWORD=

# ── Auth session cache ────────────────────────────────────────────────────────
# Path to a saved Playwright storageState JSON produced by:
#   npx ts-node tests/acceptance/setup/create-auth-session.ts
# When set, tests using authedPage skip the login step and restore the session.
# The JSON file must never be committed; restore it from a secrets store in CI.
AURORA_AUTH_SESSION_PATH=
